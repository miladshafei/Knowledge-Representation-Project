Prefix(:=<http://www.healthcareontology.org/healthcare#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<http://www.healthcareontology.org/healthcare>
Annotation(:versionInfo "1.0")
Annotation(:ontologyPurpose "Healthcare Clinical Ontology for Academic Project")
Annotation(:reviewedBy "Professor Matteo Cristani")

Declaration(Class(:Appointment))
Declaration(Class(:Department))
Declaration(Class(:Diagnosis))
Declaration(Class(:Disease))
Declaration(Class(:Doctor))
Declaration(Class(:EmergencyContact))
Declaration(Class(:Hospital))
Declaration(Class(:Insurance))
Declaration(Class(:LaboratoryTest))
Declaration(Class(:MedicalRecord))
Declaration(Class(:Medication))
Declaration(Class(:Nurse))
Declaration(Class(:Patient))
Declaration(Class(:Prescription))
Declaration(Class(:Treatment))
Declaration(ObjectProperty(:assignedNurse))
ObjectPropertyDomain(:assignedNurse :Patient)
ObjectPropertyRange(:assignedNurse :Nurse)
Declaration(ObjectProperty(:assistsDoctor))
ObjectPropertyDomain(:assistsDoctor :Nurse)
ObjectPropertyRange(:assistsDoctor :Doctor)
Declaration(ObjectProperty(:attendsAppointment))
ObjectPropertyDomain(:attendsAppointment :Doctor)
ObjectPropertyRange(:attendsAppointment :Appointment)
Declaration(ObjectProperty(:belongsToHospital))
ObjectPropertyDomain(:belongsToHospital :Department)
ObjectPropertyRange(:belongsToHospital :Hospital)
Declaration(ObjectProperty(:conductsTest))
ObjectPropertyDomain(:conductsTest :Doctor)
ObjectPropertyRange(:conductsTest :LaboratoryTest)
Declaration(ObjectProperty(:containsDiagnosis))
ObjectPropertyDomain(:containsDiagnosis :MedicalRecord)
ObjectPropertyRange(:containsDiagnosis :Diagnosis)
Declaration(ObjectProperty(:diagnosedWith))
ObjectPropertyDomain(:diagnosedWith :Patient)
ObjectPropertyRange(:diagnosedWith :Disease)
Declaration(ObjectProperty(:hasAppointment))
ObjectPropertyDomain(:hasAppointment :Patient)
ObjectPropertyRange(:hasAppointment :Appointment)
Declaration(ObjectProperty(:hasDoctor))
ObjectPropertyDomain(:hasDoctor :Patient)
ObjectPropertyRange(:hasDoctor :Doctor)
Declaration(ObjectProperty(:hasEmergencyContact))
ObjectPropertyDomain(:hasEmergencyContact :Patient)
ObjectPropertyRange(:hasEmergencyContact :EmergencyContact)
Declaration(ObjectProperty(:hasInsurance))
ObjectPropertyDomain(:hasInsurance :Patient)
ObjectPropertyRange(:hasInsurance :Insurance)
Declaration(ObjectProperty(:hasMedicalRecord))
ObjectPropertyDomain(:hasMedicalRecord :Patient)
ObjectPropertyRange(:hasMedicalRecord :MedicalRecord)
Declaration(ObjectProperty(:includesMedication))
ObjectPropertyDomain(:includesMedication :Prescription)
ObjectPropertyRange(:includesMedication :Medication)
Declaration(ObjectProperty(:managedBy))
ObjectPropertyDomain(:managedBy :Hospital)
ObjectPropertyRange(:managedBy :Doctor)
Declaration(ObjectProperty(:prescribes))
ObjectPropertyDomain(:prescribes :Doctor)
ObjectPropertyRange(:prescribes :Prescription)
Declaration(ObjectProperty(:receivesTreatment))
ObjectPropertyDomain(:receivesTreatment :Patient)
ObjectPropertyRange(:receivesTreatment :Treatment)
Declaration(ObjectProperty(:recommendedTreatment))
ObjectPropertyDomain(:recommendedTreatment :Diagnosis)
ObjectPropertyRange(:recommendedTreatment :Treatment)
Declaration(ObjectProperty(:relatedDisease))
ObjectPropertyDomain(:relatedDisease :LaboratoryTest)
ObjectPropertyRange(:relatedDisease :Disease)
Declaration(ObjectProperty(:treatedAt))
ObjectPropertyDomain(:treatedAt :Patient)
ObjectPropertyRange(:treatedAt :Hospital)
Declaration(ObjectProperty(:worksIn))
ObjectPropertyDomain(:worksIn :Doctor)
ObjectPropertyRange(:worksIn :Department)
Declaration(DataProperty(:appointmentDate))
Declaration(DataProperty(:appointmentTime))
Declaration(DataProperty(:contactPhone))
Declaration(DataProperty(:departmentName))
Declaration(DataProperty(:diagnosisDate))
Declaration(DataProperty(:diseaseName))
Declaration(DataProperty(:doctorName))
Declaration(DataProperty(:doctorSpecialization))
Declaration(DataProperty(:dosage))
Declaration(DataProperty(:hospitalLocation))
Declaration(DataProperty(:hospitalName))
Declaration(DataProperty(:insuranceProvider))
Declaration(DataProperty(:medicationName))
Declaration(DataProperty(:patientAge))
Declaration(DataProperty(:patientGender))
Declaration(DataProperty(:patientID))
Declaration(DataProperty(:patientName))
Declaration(DataProperty(:testName))
Declaration(DataProperty(:testResult))
Declaration(DataProperty(:treatmentCost))
Declaration(NamedIndividual(:AnnaPatient))
ClassAssertion(:Patient :AnnaPatient)
ObjectPropertyAssertion(:hasDoctor :AnnaPatient :DrSmith)
ObjectPropertyAssertion(:treatedAt :AnnaPatient :CityHospital)
DataPropertyAssertion(:patientAge :AnnaPatient "45"^^xsd:integer)
DataPropertyAssertion(:patientGender :AnnaPatient "Female")
DataPropertyAssertion(:patientID :AnnaPatient "P1001")
DataPropertyAssertion(:patientName :AnnaPatient "Anna Rossi")
Declaration(NamedIndividual(:Cardiology))
ClassAssertion(:Department :Cardiology)
ObjectPropertyAssertion(:belongsToHospital :Cardiology :CityHospital)
DataPropertyAssertion(:departmentName :Cardiology "Cardiology")
Declaration(NamedIndividual(:CityHospital))
ClassAssertion(:Hospital :CityHospital)
DataPropertyAssertion(:hospitalLocation :CityHospital "Milan")
DataPropertyAssertion(:hospitalName :CityHospital "City Hospital")
Declaration(NamedIndividual(:DrSmith))
ClassAssertion(:Doctor :DrSmith)
ObjectPropertyAssertion(:worksIn :DrSmith :Cardiology)
DataPropertyAssertion(:doctorName :DrSmith "John Smith")
DataPropertyAssertion(:doctorSpecialization :DrSmith "Cardiologist")
Declaration(NamedIndividual(:HeartDisease))
ClassAssertion(:Disease :HeartDisease)
DataPropertyAssertion(:diseaseName :HeartDisease "Heart Disease")
Declaration(AnnotationProperty(:createdBy))
Declaration(AnnotationProperty(:ontologyPurpose))
Declaration(AnnotationProperty(:reviewedBy))
Declaration(AnnotationProperty(:versionInfo))
)
